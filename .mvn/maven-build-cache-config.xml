<?xml version="1.0" encoding="UTF-8"?>
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.0.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.0.0 http://maven.apache.org/xsd/build-cache-config-1.0.0.xsd">
    <input>
        <global>
            <!--
                 Track remap.xml as an input of any module that has one.
                 Without this, changes to the mapping don't invalidate the
                 cached consulo.kotlin.remapped jar and remap-jar gets skipped.
            -->
            <includes>
                <include glob="remap.xml">.</include>
            </includes>
        </global>
    </input>
</cache>
