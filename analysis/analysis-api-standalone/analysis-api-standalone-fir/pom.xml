<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo.kotlin</groupId>
        <artifactId>consulo.kotlin.parent</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>consulo.kotlin.analysis.api-standalone-fir</artifactId>

    <build>
        <plugins>
            <!-- Only the PSI references resolved through the Analysis API (KtReference and its K2 implementations); the
                 standalone session itself is not used in the IDE (subset by consulo-internal/remap/subset.py) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>filter-src</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/filtered-sources/src</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src</directory>
                                    <includes>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBaseArrayAccessReference.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBaseCollectionLiteralReference.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBaseConstructorDelegationReference.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBaseDefaultAnnotationArgumentReference.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBaseDestructuringDeclarationReference.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBaseForLoopInReference.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBaseInvokeFunctionReference.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBaseKDocReference.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBasePropertyDelegationMethodsReference.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBaseReference.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBaseReferenceResolver.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaBaseSimpleNameReference.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/KaSimpleNameReferenceBase.kt</include>
                                        <include>org/jetbrains/kotlin/analysis/api/standalone/fir/references/ReadWriteAccessCheckerBaseImpl.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/AbstractKtReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KDocReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtArrayAccessReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtCollectionLiteralReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtConstructorDelegationReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtDefaultAnnotationArgumentReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtDestructuringDeclarationReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtForLoopInReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtInvokeFunctionReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtPropertyDelegationMethodsReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtReferenceMutateService.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/KtSimpleNameReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/ReadWriteAccessChecker.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/SyntheticPropertyAccessorReference.kt</include>
                                        <include>org/jetbrains/kotlin/idea/references/referenceUtils.kt</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args combine.children="append">
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaImplementationDetail</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaExperimentalApi</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaNonPublicApi</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaIdeApi</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.analysis.api.KaPlatformInterface</arg>
                    </args>
                    <sourceDirs>
                        <sourceDir>${project.build.directory}/filtered-sources/src</sourceDir>
                    </sourceDirs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.kotlin.analysis.api-fir</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.kotlin.intellij-stubs</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
