<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo</groupId>
        <artifactId>arch.managment</artifactId>
        <version>3-SNAPSHOT</version>
    </parent>

    <groupId>consulo.kotlin</groupId>
    <artifactId>consulo.kotlin.parent</artifactId>
    <version>3-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <protobuf.version>4.28.2</protobuf.version>
        <kotlin.compiler.version>2.5.20-dev-4223</kotlin.compiler.version>
        <!-- javac release (arch.managment defaults to 25); same as kotlin-maven-plugin jvmTarget -->
        <default.java.level>21</default.java.level>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.compiler.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                    <sourceDirs>
                        <sourceDir>${project.basedir}/src</sourceDir>
                        <sourceDir>${project.basedir}/gen</sourceDir>
                    </sourceDirs>
                    <args>
                        <arg>-Xwhen-guards</arg>
                        <arg>-Xnon-local-break-continue</arg>
                        <arg>-Xcontext-parameters</arg>
                        <arg>-Xmulti-dollar-interpolation</arg>
                        <arg>-XXLanguage:+WhenGuards</arg>
                        <arg>-XXLanguage:+ContextParameters</arg>
                        <arg>-Xjvm-default=all</arg>
                        <!-- Same as upstream common-configuration + dogfoodedExperimentalFeatures. -->
                        <arg>-Xdont-warn-on-error-suppression</arg>
                        <arg>-Xskip-prerelease-check</arg>
                        <arg>-Xexplicit-backing-fields</arg>
                        <arg>-Xname-based-destructuring=complete</arg>
                        <arg>-Xcollection-literals</arg>
                        <arg>-Xcontext-sensitive-resolution</arg>
                        <arg>-Xexplicit-context-arguments</arg>
                        <arg>-Xwarning-level=REDUNDANT_CLI_ARG:disabled</arg>
                        <!-- Kotlin internal opt-ins used across multiple modules. -->
                        <arg>-opt-in=kotlin.contracts.ExperimentalContracts</arg>
                        <arg>-opt-in=kotlin.RequiresOptIn</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.symbols.SymbolInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.PrivateForInline</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.UnresolvedExpressionTypeAccess</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.declarations.ResolveStateAccess</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.declarations.SealedClassInheritorsProviderInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.declarations.DirectDeclarationsAccess</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.declarations.utils.SuspiciousValueClassCheck</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.scopes.ScopeFunctionRequiresPrewarm</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.scopes.DelicateScopeAPI</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.symbols.impl.LookupTagInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.symbols.impl.RenderingInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.types.UnexpandedTypeCheck</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.resolve.dfa.cfg.CfgInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.analysis.CheckersComponentInternal</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.resolve.providers.FirSymbolProviderInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.expressions.UnsafeExpressionUtility</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.types.model.K2Only</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.K1Deprecation</arg>
                    </args>
                </configuration>
            </plugin>
            <!-- Java compiler must run after Kotlin for mixed sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>java-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- copy-resources never deletes, so files removed upstream would stay in filtered-sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>clean-filtered-sources</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/filtered-sources</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>kotlin-bootstrap</id>
            <url>https://maven.pkg.jetbrains.space/kotlin/p/kotlin/bootstrap</url>
        </repository>
        <repository>
            <id>consulo</id>
            <url>https://maven.consulo.dev/repository/snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>interval:60</updatePolicy>
            </snapshots>
        </repository>
        <repository>
            <id>intellij-dependencies</id>
            <url>https://cache-redirector.jetbrains.com/intellij-dependencies</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>kotlin-bootstrap-plugins</id>
            <url>https://maven.pkg.jetbrains.space/kotlin/p/kotlin/bootstrap</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencyManagement>
        <dependencies>
            <!-- IntelliJ stubs - compile-only, provides com.intellij.* signatures -->
            <dependency>
                <groupId>consulo.kotlin</groupId>
                <artifactId>consulo.kotlin.intellij-stubs</artifactId>
                <version>${project.version}</version>
