            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-collections-immutable-jvm</artifactId>
            <version>0.5.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- Analysis API caches; shipped with the plugin -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>2.9.3</version>
            <scope>provided</scope>
        </dependency>
        <!-- Analysis API statistics only, which stay off without a KotlinOpenTelemetryProvider service; not shipped -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>1.67.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- IntelliJ-shaded ASM (package org.jetbrains.org.objectweb.asm.*) —
             Kotlin compiler modules import from this prefix, not plain ASM. -->
        <dependency>
            <groupId>org.jetbrains.intellij.deps</groupId>
            <artifactId>asm-all</artifactId>
            <version>9.6.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

