<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo</groupId>
        <artifactId>arch.managment</artifactId>
        <version>3-SNAPSHOT</version>
    </parent>

    <groupId>consulo.kotlin</groupId>
    <artifactId>consulo.kotlin.parent</artifactId>
    <version>3-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <protobuf.version>4.28.2</protobuf.version>
        <kotlin.compiler.version>2.5.20-dev-4223</kotlin.compiler.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.compiler.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                    <sourceDirs>
                        <sourceDir>${project.basedir}/src</sourceDir>
                        <sourceDir>${project.basedir}/gen</sourceDir>
                    </sourceDirs>
                    <args>
                        <arg>-Xwhen-guards</arg>
                        <arg>-Xnon-local-break-continue</arg>
                        <arg>-Xcontext-parameters</arg>
                        <arg>-Xmulti-dollar-interpolation</arg>
                        <arg>-XXLanguage:+WhenGuards</arg>
                        <arg>-XXLanguage:+ContextParameters</arg>
                        <arg>-Xjvm-default=all</arg>
                        <!-- Kotlin internal opt-ins used across multiple modules. -->
                        <arg>-opt-in=kotlin.contracts.ExperimentalContracts</arg>
                        <arg>-opt-in=kotlin.RequiresOptIn</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.symbols.SymbolInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.PrivateForInline</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.UnresolvedExpressionTypeAccess</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.declarations.ResolveStateAccess</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.declarations.SealedClassInheritorsProviderInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.declarations.DirectDeclarationsAccess</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.declarations.utils.SuspiciousValueClassCheck</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.scopes.ScopeFunctionRequiresPrewarm</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.scopes.DelicateScopeAPI</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.symbols.impl.LookupTagInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.symbols.impl.RenderingInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.types.UnexpandedTypeCheck</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.resolve.dfa.cfg.CfgInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.analysis.CheckersComponentInternal</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.resolve.providers.FirSymbolProviderInternals</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.fir.expressions.UnsafeExpressionUtility</arg>
                        <arg>-opt-in=org.jetbrains.kotlin.types.model.K2Only</arg>
                    </args>
                </configuration>
            </plugin>
            <!-- Java compiler must run after Kotlin for mixed sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>java-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>kotlin-bootstrap</id>
            <url>https://maven.pkg.jetbrains.space/kotlin/p/kotlin/bootstrap</url>
        </repository>
        <repository>
            <id>consulo</id>
            <url>https://maven.consulo.dev/repository/snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>interval:60</updatePolicy>
            </snapshots>
        </repository>
        <repository>
            <id>intellij-dependencies</id>
            <url>https://cache-redirector.jetbrains.com/intellij-dependencies</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>kotlin-bootstrap-plugins</id>
            <url>https://maven.pkg.jetbrains.space/kotlin/p/kotlin/bootstrap</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencyManagement>
        <dependencies>
            <!-- IntelliJ stubs - compile-only, provides com.intellij.* signatures -->
            <dependency>
                <groupId>consulo.kotlin</groupId>
                <artifactId>consulo.kotlin.intellij-stubs</artifactId>
                <version>${project.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Common dependencies for all modules -->
    <dependencies>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.0.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.compiler.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
            <version>${kotlin.compiler.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-annotations-jvm</artifactId>
            <version>2.2.21</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
            <version>1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vavr</groupId>
            <artifactId>vavr</artifactId>
            <version>0.10.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-collections-immutable-jvm</artifactId>
            <version>0.4.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- IntelliJ-shaded ASM (package org.jetbrains.org.objectweb.asm.*) —
             Kotlin compiler modules import from this prefix, not plain ASM. -->
        <dependency>
            <groupId>org.jetbrains.intellij.deps</groupId>
            <artifactId>asm-all</artifactId>
            <version>9.6.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <modules>
        <!-- Tier 0: Foundation (no IntelliJ deps) -->
        <module>core/names</module>
        <module>core/util.runtime</module>
        <module>core/error.handling</module>
        <module>core/language.model</module>
        <module>core/language.targets</module>
        <module>core/language.targets.jvm</module>
        <module>compiler/compiler.version</module>
        <module>core/language.version-settings</module>
        <module>core/compiler.common</module>
        <module>core/metadata</module>

        <!-- Consulo internal: stubs, shade, protobuf -->
        <module>consulo-internal</module>

        <!-- Tier 1: Compiler infrastructure (IntelliJ compile-only) -->
        <module>core/metadata.jvm</module>
        <module>core/compiler.common.jvm</module>
        <module>core/deserialization.common</module>
        <module>core/deserialization.common.jvm</module>
        <module>core/descriptors</module>
        <module>core/descriptors.jvm</module>
        <module>core/compiler.common.js</module>
        <module>core/deserialization</module>
        <module>compiler/resolution.common</module>
        <module>compiler/resolution.common.jvm</module>
        <module>compiler/util</module>
        <module>compiler/config</module>
        <module>compiler/plugin-api</module>
        <module>compiler/frontend.common</module>

        <!-- Tier 2: PSI -->
        <module>compiler/multiplatform-parsing</module>
        <module>compiler/psi/psi-api</module>
        <module>compiler/psi/parser</module>
        <module>compiler/psi/psi-impl</module>
        <module>compiler/psi/psi-utils</module>
        <module>compiler/psi/psi-frontend-utils</module>

        <!-- Tier 3: Frontend common (PSI-aware + JVM-aware) -->
        <module>compiler/frontend.common-psi</module>
        <module>compiler/frontend.common.jvm</module>

        <!-- Tier 4: FIR (K2) -->
        <module>compiler/fir/cones</module>
        <module>compiler/fir/tree</module>
        <module>compiler/fir/semantics.api</module>
        <module>compiler/fir/resolve</module>
        <module>compiler/fir/diagnostic-renderers</module>
        <module>compiler/fir/fir-deserialization</module>
        <module>compiler/fir/raw-fir/raw-fir.common</module>
        <module>compiler/fir/raw-fir/psi2fir</module>
        <module>compiler/fir/raw-fir/light-tree2fir</module>
        <module>compiler/fir/checkers/checkers.api</module>
        <module>compiler/fir/checkers/checkers.common</module>
        <!-- needs fir2ir and fir-serialization since upstream renamed plugin-utils to plugin.api -->
        <!--<module>compiler/fir/plugin.api</module>-->

        <!-- Tier 5: Analysis API -->
        <!-- needs analysis-api since upstream merge -->
        <!--<module>analysis/analysis-internal-utils</module>-->
    </modules>
</project>
