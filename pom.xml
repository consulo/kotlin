<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>consulo</groupId>
        <artifactId>arch.managment</artifactId>
        <version>3-SNAPSHOT</version>
    </parent>

    <groupId>consulo.kotlin</groupId>
    <artifactId>consulo.kotlin.parent</artifactId>
    <version>3-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <protobuf.version>4.28.2</protobuf.version>
        <kotlin.compiler.version>2.4.0-dev-8449</kotlin.compiler.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.compiler.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                    <sourceDirs>
                        <sourceDir>${project.basedir}/src</sourceDir>
                        <sourceDir>${project.basedir}/gen</sourceDir>
                    </sourceDirs>
                    <args>
                        <arg>-Xwhen-guards</arg>
                        <arg>-Xnon-local-break-continue</arg>
                        <arg>-Xcontext-parameters</arg>
                        <arg>-Xmulti-dollar-interpolation</arg>
                        <arg>-XXLanguage:+WhenGuards</arg>
                        <arg>-XXLanguage:+ContextParameters</arg>
                        <arg>-Xjvm-default=all</arg>
                    </args>
                </configuration>
            </plugin>
            <!-- Java compiler must run after Kotlin for mixed sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>java-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>kotlin-bootstrap</id>
            <url>https://maven.pkg.jetbrains.space/kotlin/p/kotlin/bootstrap</url>
        </repository>
        <repository>
            <id>consulo</id>
            <url>https://maven.consulo.dev/repository/snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>interval:60</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>kotlin-bootstrap-plugins</id>
            <url>https://maven.pkg.jetbrains.space/kotlin/p/kotlin/bootstrap</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencyManagement>
        <dependencies>
            <!-- IntelliJ stubs - compile-only, provides com.intellij.* signatures -->
            <dependency>
                <groupId>consulo.kotlin</groupId>
                <artifactId>consulo.kotlin.intellij-stubs</artifactId>
                <version>${project.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Common dependencies for all modules -->
    <dependencies>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.0.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.compiler.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-annotations-jvm</artifactId>
            <version>2.2.21</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <modules>
        <!-- Tier 0: Foundation (no IntelliJ deps) -->
        <module>core/names</module>
        <module>core/util.runtime</module>
        <module>core/language.model</module>
        <module>core/language.targets</module>
        <module>compiler/compiler.version</module>
        <module>core/language.version-settings</module>
        <module>core/compiler.common</module>
        <module>core/metadata</module>

        <!-- Consulo internal: stubs, shade, protobuf -->
        <module>consulo-internal</module>

        <!-- Tier 1: Compiler infrastructure (IntelliJ compile-only) -->
        <module>compiler/util</module>
        <module>compiler/container</module>
        <module>compiler/config</module>
        <module>compiler/plugin-api</module>
        <module>compiler/frontend.common</module>

        <!-- Tier 2: PSI -->
        <module>compiler/psi/psi-api</module>
        <module>compiler/psi/parser</module>
        <module>compiler/psi/psi-impl</module>
    </modules>
</project>
